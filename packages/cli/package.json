{
  "name": "agentic-e2e",
  "version": "0.1.0",
  "description": "Plain-English end-to-end tests run by an AI agent against an ephemeral preview of your PR's build. Self-healing, with a video replay of every failure. Built on Solari.",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai",
    "agent",
    "agentic",
    "playwright",
    "ci",
    "github-actions",
    "self-healing",
    "accessibility",
    "pull-request",
    "solari"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Dhevenddra/agentic-e2e-ci#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhevenddra/agentic-e2e-ci.git"
  },
  "bugs": { "url": "https://github.com/Dhevenddra/agentic-e2e-ci/issues" },
  "bin": { "agentic-e2e": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.6" },
  "scripts": { "build": "node build.mjs" },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@solarisdk/browser": "^0.1.3",
    "@solarisdk/sandbox": "^0.1.2",
    "openai": "^7.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@agentic-e2e/action": "workspace:*",
    "@agentic-e2e/config": "workspace:*",
    "esbuild": "^0.21.5"
  }
}
