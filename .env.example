# Names only. Never commit values.
SOLARI_API_KEY=slr_live_xxx

# LLM for the agent's per-step resolution. Default provider: Fireworks AI
# (OpenAI-compatible). Paste your Fireworks key as MODEL_API_KEY.
MODEL_API_KEY=
# Optional overrides (sane defaults baked into code):
#   MODEL_BASE_URL default = https://api.fireworks.ai/inference/v1
#   MODEL_ID       default = auto-selected/pinned after a live models-list check
MODEL_BASE_URL=
MODEL_ID=

GITHUB_TOKEN=

# Test credentials for the app under test (referenced by name in agent-e2e.config.ts)
TEST_PASSWORD=
